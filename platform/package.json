{
  "name": "pesmetal-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma comercial completa PESMETAL — Site + CRM + Kanban + WhatsApp + Automações + Dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:admin\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && npm run dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run build:api && npm run build:admin && npm run build:web",
    "build:api": "cd apps/api && npm run build",
    "build:admin": "cd apps/admin && npm run build",
    "build:web": "cd apps/web && npm run build",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json",
    "db:migrate": "cd apps/api && npm run db:migrate",
    "db:seed": "cd apps/api && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0"
  }
}
