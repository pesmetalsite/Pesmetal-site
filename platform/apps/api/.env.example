# =============================================================
# PESMETAL API — environment template
# Copie para `.env` local ou configure no Railway.
# NUNCA commite credenciais reais. Use placeholders aqui.
# =============================================================

# === SERVER ===
NODE_ENV=production
PORT=4000
API_BASE_URL=https://your-api.up.railway.app
LOG_LEVEL=info

# === AUTH ===
# Gere com: openssl rand -base64 32
JWT_SECRET=change-me-in-production-32chars-min-please
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# === ADMIN SEED (criado no primeiro start) ===
ADMIN_EMAIL=admin@pesmetal.com.br
ADMIN_PASSWORD=change-this-password-in-production

# === DATABASE ===
# Banco de produção: Supabase/Postgres. A API usa o driver `pg` e lê a
# connection string de DATABASE_URL.
# URL do Supabase (Postgres). Formato:
# postgresql://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:REPLACE_WITH_SUPABASE_PASSWORD@db.REPLACE_WITH_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Fallback (somente se DATABASE_URL não for definida)
DATABASE_PATH=./data/pesmetal.db

# === EVOLUTION API (WhatsApp) ===
EVOLUTION_API_URL=https://your-evolution-api.up.railway.app
EVOLUTION_API_KEY=REPLACE_WITH_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=pesmetal-main

# === UPLOADS ===
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=15
