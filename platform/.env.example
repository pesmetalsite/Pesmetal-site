# ============================================
# PESMETAL — PLATAFORMA COMERCIAL
# ============================================

# === SERVER ===
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
PUBLIC_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# === AUTH ===
JWT_SECRET=change-me-in-production-32chars-min-please
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# === DATABASE ===
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/pesmetal.db

# === EVOLUTION API (WhatsApp) ===
EVOLUTION_API_URL=https://your-evolution-api.up.railway.app
EVOLUTION_API_KEY=replace-with-real-key-when-available
EVOLUTION_INSTANCE=pesmetal-main
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_SECRET=replace-with-real-secret

# === COMPANY ===
COMPANY_NAME=Pes Metal
COMPANY_PHONE=
COMPANY_WHATSAPP=
COMPANY_EMAIL=
COMPANY_ADDRESS=
COMPANY_CITY=Sorocaba
COMPANY_STATE=SP
COMPANY_BUSINESS_HOURS=Segunda a Sexta, 08:00 às 18:00
COMPANY_EXPERIENCE_YEARS=30

# === TRACKING / META ===
META_PIXEL_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
META_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=

# === UPLOADS ===
UPLOAD_MAX_MB=15
UPLOAD_DIR=./data/uploads

# === FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
